HEART360TK_VERSION=0.6.0
POSTGRES_HOST=postgres
POSTGRES_DB=heart360tk_database
POSTGRES_USER=heart360tk
POSTGRES_PASSWORD=REPLACE_WITH_EXISTING_DATABASE_USER_PASSWORD
GF_DATABASE_URL=postgres://grafana:REPLACE_WITH_URL_ENCODED_GRAFANA_PASSWORD@postgres:5432/heart360tk_database
GF_SECURITY_ADMIN_PASSWORD=REPLACE_WITH_EXISTING_GRAFANA_ADMIN_PASSWORD
IMPORT_CRON=10 * * * *
IMPORT_PROTOCOL=sftp
IMPORT_AGGREGATE_DATA=true
IMPORT_FOLDER_PATH=/export
SFTP_HOST=sftp
SFTP_PORT=22
SFTP_USER=REPLACE_WITH_SFTP_IMPORT_USER
SFTP_PASSWORD=REPLACE_WITH_SFTP_IMPORT_PASSWORD
SFTP_TIMEOUT=60
S3_BUCKET=
S3_KEY_PREFIX=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=
