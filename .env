# -----------------------------------------------------------------------------
# SFTP server on the central node. Port 2222 is the host-mapped port for the
# central node's "sftp" container; port 22 on that host is the EC2 instance's
# own sshd, which is key-only and is not the SFTP service.
# -----------------------------------------------------------------------------
SFTP_HOST=13.206.119.127
SFTP_PORT=2222
SFTP_USER=h360tk_sftp
SFTP_PASSWORD=He8u^%gtRG36&^hgtyc97
SFTP_DEST_PATH=/upload
SFTP_TIMEOUT=60

# -----------------------------------------------------------------------------
# EXPORTER
# -----------------------------------------------------------------------------
SOURCE_KEY=h360tk_indonesia
EXPORT_CRON=*/1 * * * *      # Runs 5 min after the hourly refresh (0 * * * *), ensuring export reads fully-refreshed data instead of racing the refresh job
UPLOAD_PROTOCOL=sftp


# -----------------------------------------------------------------------------
# S3 server
